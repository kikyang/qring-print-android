.page { padding: 16px; }
.text-input { width: 100%; min-height: 120px; box-sizing: border-box; margin-top: 12px; }
.option-row { display: flex; align-items: center; margin-top: 12px; }
.option-label { font-size: 13px; color: #888888; margin-right: 12px; }
.picker { font-size: 14px; color: #191919; background: #F2F3F5; border-radius: 8px; padding: 8px 16px; }
.preview-canvas { width: 100%; height: 240px; margin-top: 12px; background: #FFFFFF; }
.preview-btn { margin-top: 12px; }
.print-btn { margin-top: 8px; }
.status-text { display: block; font-size: 12px; color: #888888; margin-top: 8px; }
