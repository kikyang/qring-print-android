<!-- 文字打印 -->
<view class="page">
  <view class="card">
    <view class="card-title">文字打印</view>
    <view class="card-caption">384 点宽，自动换行。打印前先预览。</view>
    <textarea class="input text-input" placeholder="输入要打印的文字" bindinput="onInput" value="{{text}}"></textarea>
    <view class="option-row">
      <text class="option-label">字号</text>
      <picker mode="selector" range="{{fontSizes}}" bindchange="onFontChange">
        <view class="picker">{{fontSizes[fontIndex]}}px</view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="card-title">打印预览</view>
    <canvas type="2d" id="previewCanvas" class="preview-canvas"></canvas>
    <button class="btn-ghost preview-btn" bindtap="onPreview">👁 预览打印效果</button>
    <button class="btn-primary print-btn" bindtap="onPrint">🖨 打印</button>
    <text class="status-text">{{status}}</text>
  </view>
</view>
